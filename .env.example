# Copy to .env and fill in. .env is git-ignored; never commit real keys.
#
# Only tool 7 (draft_opinion) calls a model. Every other tool, the whole chaos
# harness and the scorer run with no key at all, which is what makes
# `make test` work on a fresh clone.

# The model that drives the agent loop and drafts the opinion.
ANTHROPIC_API_KEY=

# Optional: override the model without editing agent/config.py.
AGENT_MODEL=

# Where the pinned Gazette notifications live. Defaults to the repo's own
# data/reference/primary/. Point it at a sibling checkout of Project 01 to
# read that copy instead — the SHA-256 check will tell you if they differ.
GAZETTE_PRIMARY_DIR=

# Cost stop. The suite aborts if the estimated spend for a run exceeds this,
# before the first call rather than after the bill. See docs/DESIGN.md §10.
MAX_RUN_USD=5.00
