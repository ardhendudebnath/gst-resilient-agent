# Copy to .env and fill in. .env is git-ignored; never commit real keys.
#
# The loop and tool 7 (draft_opinion) call a model. Every other tool, the whole
# chaos harness, the scorer and the entire test suite run with no key at all,
# which is what makes `make test` work on a fresh clone.

# ---------------------------------------------------------------------------
# Default path: NVIDIA's API catalog. Needs no SDK — the request is one POST
# over stdlib urllib — so a key here plus `pip install -e '.[gazette]'` is a
# complete working install.
#
# The default model is nvidia/nemotron-3-ultra-550b-a55b — open weights at
# frontier scale, for the multi-step judgement this agent does. Its
# self-hostable sibling, nvidia/nemotron-3-super-120b-a12b, has a published NIM
# container and reproduces any run on the same wire format; use that id for
# Project 03 and for any self-hosting claim.
#
# Note: the 550B endpoint returns 503 "Service temporarily overloaded" fairly
# often. The loop retries with backoff and reports model_retries per run.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=

# Optional: override the model without editing agent/config.py. Hosted ids get
# retired — Project 01's original pick returned "410 Gone" on its first live
# call — so expect to change this, and verify a successor by calling it.
AGENT_MODEL=

# ---------------------------------------------------------------------------
# Alternatives. Same wire format; the provider is inferred from the model id.
# ---------------------------------------------------------------------------

# Your own NIM container. No key — it is your GPU. Only set the base URL if the
# GPU is not on this machine. This is the bridge to Project 03: identical wire
# format, so the only difference from the hosted row is this URL.
NIM_BASE_URL=http://localhost:8000
NIM_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional frontier comparison row. Needs the SDK: pip install -e '.[anthropic]'
# A zero-arg client also resolves ANTHROPIC_AUTH_TOKEN.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Paths and stops
# ---------------------------------------------------------------------------

# Where the pinned Gazette notifications live. Defaults to the repo's own
# data/reference/primary/. Point it at a sibling checkout of Project 01 to read
# that copy instead — the SHA-256 check will tell you if they differ.
GAZETTE_PRIMARY_DIR=

# Where run traces are written. Defaults to traces/.
TRACE_DIR=

# Cost stop. The suite aborts if the estimated spend for a run exceeds this,
# before the first call rather than after the bill. See docs/DESIGN.md §10.
MAX_RUN_USD=5.00
